                <h2 class="text-3xl font-bold text-white font-serif mb-3">The Story Behind the Song</h2>
                <div class="w-20 h-1 bg-amber-lantern mx-auto rounded-full"></div>
            </div>

            <div class="grid md:grid-cols-2 gap-8 items-stretch">
                <!-- Highlighted Chorus Block -->
